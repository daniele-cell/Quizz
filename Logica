<!DOCTYPE html>

<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Treinamento de Raciocínio Lógico</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Fredoka+One&display=swap');

:root {
–bg: #0f0e17;
–card: #1a1a2e;
–card2: #16213e;
–accent: #f5a623;
–accent2: #e63946;
–green: #06d6a0;
–purple: #a855f7;
–blue: #3b82f6;
–text: #fffffe;
–muted: #a7a9be;
–border: rgba(255,255,255,0.08);
}

- { box-sizing: border-box; margin: 0; padding: 0; }

body {
font-family: ‘Nunito’, sans-serif;
background: var(–bg);
color: var(–text);
min-height: 100vh;
overflow-x: hidden;
}

/* Stars background */
body::before {
content: ‘’;
position: fixed;
inset: 0;
background-image:
radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4) 0%, transparent 100%),
radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
radial-gradient(1px 1px at 70% 80%, rgba(255,255,255,0.3) 0%, transparent 100%),
radial-gradient(1px 1px at 90% 40%, rgba(255,255,255,0.4) 0%, transparent 100%),
radial-gradient(1px 1px at 20% 90%, rgba(255,255,255,0.2) 0%, transparent 100%),
radial-gradient(1px 1px at 80% 15%, rgba(255,255,255,0.3) 0%, transparent 100%),
radial-gradient(1px 1px at 45% 75%, rgba(255,255,255,0.2) 0%, transparent 100%);
pointer-events: none;
z-index: 0;
}

.container {
max-width: 760px;
margin: 0 auto;
padding: 24px 16px 60px;
position: relative;
z-index: 1;
}

/* Header */
.header {
text-align: center;
margin-bottom: 32px;
}

.header .emoji-row {
font-size: 2.4rem;
margin-bottom: 8px;
animation: float 3s ease-in-out infinite;
}

@keyframes float {
0%, 100% { transform: translateY(0); }
50% { transform: translateY(-8px); }
}

.header h1 {
font-family: ‘Fredoka One’, cursive;
font-size: 2rem;
background: linear-gradient(135deg, var(–accent), var(–purple));
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
line-height: 1.2;
margin-bottom: 6px;
}

.header p {
color: var(–muted);
font-size: 0.95rem;
font-weight: 600;
}

/* Progress bar */
.progress-area {
margin-bottom: 24px;
}

.progress-meta {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 8px;
}

.progress-meta span {
font-size: 0.85rem;
font-weight: 700;
color: var(–muted);
}

.progress-meta .score-badge {
background: linear-gradient(135deg, var(–accent), #ff6b35);
color: #000;
border-radius: 20px;
padding: 3px 12px;
font-size: 0.82rem;
font-weight: 800;
}

.progress-bar-bg {
background: var(–card);
border-radius: 99px;
height: 10px;
overflow: hidden;
border: 1px solid var(–border);
}

.progress-bar-fill {
height: 100%;
border-radius: 99px;
background: linear-gradient(90deg, var(–purple), var(–accent));
transition: width 0.5s ease;
}

/* Question card */
.question-card {
background: var(–card);
border: 1px solid var(–border);
border-radius: 20px;
padding: 28px 24px;
margin-bottom: 20px;
position: relative;
overflow: hidden;
animation: slideIn 0.4s ease;
}

@keyframes slideIn {
from { opacity: 0; transform: translateY(20px); }
to { opacity: 1; transform: translateY(0); }
}

.question-card::before {
content: ‘’;
position: absolute;
top: 0; left: 0; right: 0;
height: 3px;
background: linear-gradient(90deg, var(–purple), var(–accent), var(–green));
}

.category-tag {
display: inline-flex;
align-items: center;
gap: 6px;
background: rgba(168, 85, 247, 0.15);
border: 1px solid rgba(168, 85, 247, 0.3);
color: var(–purple);
border-radius: 99px;
padding: 4px 12px;
font-size: 0.78rem;
font-weight: 700;
margin-bottom: 16px;
text-transform: uppercase;
letter-spacing: 0.5px;
}

.question-number {
font-size: 0.8rem;
font-weight: 700;
color: var(–muted);
margin-bottom: 10px;
}

.question-text {
font-size: 1.05rem;
font-weight: 700;
line-height: 1.6;
color: var(–text);
margin-bottom: 8px;
}

.question-source {
font-size: 0.75rem;
color: var(–muted);
font-style: italic;
margin-bottom: 24px;
opacity: 0.7;
}

/* Options */
.options {
display: flex;
flex-direction: column;
gap: 10px;
}

.option-btn {
background: var(–card2);
border: 2px solid var(–border);
border-radius: 14px;
padding: 14px 18px;
color: var(–text);
font-family: ‘Nunito’, sans-serif;
font-size: 0.95rem;
font-weight: 600;
cursor: pointer;
text-align: left;
display: flex;
align-items: center;
gap: 12px;
transition: all 0.2s ease;
position: relative;
overflow: hidden;
}

.option-btn:hover:not(:disabled) {
border-color: var(–purple);
background: rgba(168, 85, 247, 0.1);
transform: translateX(4px);
}

.option-letter {
width: 30px;
height: 30px;
border-radius: 50%;
background: rgba(255,255,255,0.06);
border: 2px solid rgba(255,255,255,0.15);
display: flex;
align-items: center;
justify-content: center;
font-size: 0.82rem;
font-weight: 800;
flex-shrink: 0;
transition: all 0.2s;
}

.option-btn.correct {
border-color: var(–green);
background: rgba(6, 214, 160, 0.12);
}

.option-btn.correct .option-letter {
background: var(–green);
border-color: var(–green);
color: #000;
}

.option-btn.wrong {
border-color: var(–accent2);
background: rgba(230, 57, 70, 0.12);
}

.option-btn.wrong .option-letter {
background: var(–accent2);
border-color: var(–accent2);
color: #fff;
}

.option-btn:disabled { cursor: default; }

/* Feedback */
.feedback-box {
display: none;
border-radius: 16px;
padding: 16px 20px;
margin-top: 16px;
font-size: 0.9rem;
line-height: 1.6;
font-weight: 600;
animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
from { opacity: 0; transform: translateY(8px); }
to { opacity: 1; transform: translateY(0); }
}

.feedback-box.correct {
background: rgba(6, 214, 160, 0.1);
border: 1px solid rgba(6, 214, 160, 0.3);
color: var(–green);
}

.feedback-box.wrong {
background: rgba(230, 57, 70, 0.1);
border: 1px solid rgba(230, 57, 70, 0.3);
color: #ff8a94;
}

.feedback-box .fb-title {
font-size: 1rem;
font-weight: 800;
margin-bottom: 6px;
}

.feedback-box .fb-explanation {
color: var(–muted);
font-weight: 600;
font-size: 0.88rem;
}

/* Next button */
.next-btn {
display: none;
width: 100%;
background: linear-gradient(135deg, var(–purple), var(–blue));
color: #fff;
border: none;
border-radius: 14px;
padding: 16px;
font-family: ‘Nunito’, sans-serif;
font-size: 1rem;
font-weight: 800;
cursor: pointer;
margin-top: 16px;
transition: all 0.2s;
letter-spacing: 0.3px;
}

.next-btn:hover {
transform: translateY(-2px);
box-shadow: 0 8px 24px rgba(168, 85, 247, 0.4);
}

/* Result Screen */
.result-screen {
display: none;
text-align: center;
animation: slideIn 0.5s ease;
}

.result-trophy {
font-size: 5rem;
margin-bottom: 16px;
animation: bounce 1s ease infinite;
}

@keyframes bounce {
0%, 100% { transform: translateY(0) rotate(-5deg); }
50% { transform: translateY(-15px) rotate(5deg); }
}

.result-title {
font-family: ‘Fredoka One’, cursive;
font-size: 2.2rem;
margin-bottom: 8px;
background: linear-gradient(135deg, var(–accent), var(–purple));
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
}

.result-subtitle {
color: var(–muted);
font-size: 1rem;
font-weight: 600;
margin-bottom: 32px;
}

.result-stats {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 12px;
margin-bottom: 32px;
}

.stat-box {
background: var(–card);
border: 1px solid var(–border);
border-radius: 16px;
padding: 20px 12px;
}

.stat-number {
font-family: ‘Fredoka One’, cursive;
font-size: 2.2rem;
line-height: 1;
margin-bottom: 4px;
}

.stat-label {
font-size: 0.78rem;
font-weight: 700;
color: var(–muted);
text-transform: uppercase;
letter-spacing: 0.5px;
}

.stat-box:nth-child(1) .stat-number { color: var(–green); }
.stat-box:nth-child(2) .stat-number { color: var(–accent2); }
.stat-box:nth-child(3) .stat-number { color: var(–accent); }

.review-list {
text-align: left;
margin-bottom: 28px;
}

.review-list h3 {
font-size: 0.85rem;
font-weight: 800;
color: var(–muted);
text-transform: uppercase;
letter-spacing: 0.8px;
margin-bottom: 12px;
}

.review-item {
background: var(–card);
border-radius: 12px;
padding: 12px 16px;
margin-bottom: 8px;
border: 1px solid var(–border);
display: flex;
align-items: center;
gap: 10px;
font-size: 0.88rem;
font-weight: 600;
}

.review-dot {
width: 10px;
height: 10px;
border-radius: 50%;
flex-shrink: 0;
}

.review-dot.ok { background: var(–green); }
.review-dot.fail { background: var(–accent2); }

.restart-btn {
width: 100%;
background: linear-gradient(135deg, var(–accent), #ff6b35);
color: #000;
border: none;
border-radius: 14px;
padding: 18px;
font-family: ‘Nunito’, sans-serif;
font-size: 1.1rem;
font-weight: 900;
cursor: pointer;
transition: all 0.2s;
letter-spacing: 0.3px;
}

.restart-btn:hover {
transform: translateY(-3px);
box-shadow: 0 10px 28px rgba(245, 166, 35, 0.4);
}

/* Congrats message */
.congrats-msg {
font-size: 1rem;
font-weight: 700;
color: var(–text);
background: var(–card);
border: 1px solid var(–border);
border-radius: 14px;
padding: 16px 20px;
margin-bottom: 24px;
line-height: 1.6;
}
</style>

</head>
