<script>
const questions = [
  {
    category: "🔢 Sequências Numéricas",
    text: "Qual é o próximo número na sequência? 2, 4, 6, 8, __",
    options: ["9", "10", "11", "12"],
    correct: 1,
    source: "Adaptada de: CESPE/CEBRASPE — Concurso Público Municipal",
    explanation: "A sequência aumenta de 2 em 2 (números pares). Depois do 8 vem o 10."
  },
  {
    category: "🔢 Sequências Numéricas",
    text: "Observe a sequência: 1, 4, 9, 16, 25, __. Qual é o próximo número?",
    options: ["30", "36", "32", "49"],
    correct: 1,
    source: "Adaptada de: FCC — Concurso para Auxiliar Administrativo",
    explanation: "São os quadrados perfeitos: 1²=1, 2²=4, 3²=9, 4²=16, 5²=25, 6²=36."
  },
  {
    category: "🧩 Lógica de Situação",
    text: "Ana é mais alta que Bia. Bia é mais alta que Carol. Quem é a mais baixa das três?",
    options: ["Ana", "Bia", "Carol", "Todas têm a mesma altura"],
    correct: 2,
    source: "Adaptada de: VUNESP — Processo Seletivo Municipal",
    explanation: "Ana > Bia > Carol. Como Carol é menor que Bia, e Bia é menor que Ana, Carol é a mais baixa."
  },
  {
    category: "🧩 Lógica de Situação",
    text: "Todos os gatos são animais. Mimi é um gato. O que podemos concluir?",
    options: ["Mimi é um cachorro", "Mimi é um animal", "Mimi não é um animal", "Nada pode ser concluído"],
    correct: 1,
    source: "Adaptada de: IBGE — Recenseador",
    explanation: "Se todos os gatos são animais, e Mimi é um gato, então Mimi obrigatoriamente é um animal."
  },
  {
    category: "🎭 Verdadeiro ou Falso",
    text: "Pedro diz: 'Eu sempre minto.' Se essa afirmação for verdadeira, então Pedro está dizendo a verdade — mas ele afirmou que sempre mente. Se for falsa, então ele nem sempre mente, e pode estar dizendo a verdade agora. Essa situação é chamada de:",
    options: ["Sequência lógica", "Paradoxo", "Silogismo", "Hipótese"],
    correct: 1,
    source: "Adaptada de: ENADE — questão de raciocínio lógico",
    explanation: "É um paradoxo: uma situação onde a afirmação contradiz a si mesma, sem ter resposta certa."
  },
  {
    category: "🔢 Sequências Numéricas",
    text: "Qual é o número que falta? 3, 6, 12, 24, __",
    options: ["36", "42", "48", "30"],
    correct: 2,
    source: "Adaptada de: FUNDATEC — Prefeitura de Porto Alegre",
    explanation: "Cada número é multiplicado por 2: 3×2=6, 6×2=12, 12×2=24, 24×2=48."
  },
  {
    category: "🏠 Raciocínio Espacial",
    text: "Um quadrado tem 4 lados iguais. Se dobramos o lado de um quadrado de 3 cm para 6 cm, quanto fica o perímetro (soma de todos os lados)?",
    options: ["12 cm", "18 cm", "24 cm", "36 cm"],
    correct: 2,
    source: "Adaptada de: CESPE/CEBRASPE — Técnico Administrativo INSS",
    explanation: "Novo lado = 6 cm. Perímetro = 4 × 6 = 24 cm."
  },
  {
    category: "🧩 Lógica de Situação",
    text: "Em uma prova com 20 questões, João acertou 3/4 das questões. Quantas questões João acertou?",
    options: ["12", "14", "15", "16"],
    correct: 2,
    source: "Adaptada de: FGV — Agente Administrativo",
    explanation: "3/4 de 20 = (3 × 20) ÷ 4 = 60 ÷ 4 = 15 questões."
  },
  {
    category: "🎲 Combinações",
    text: "Uma escola serve 3 tipos de suco (laranja, uva e maçã) e 2 tipos de lanche (pão e biscoito). De quantas combinações diferentes um aluno pode escolher 1 suco e 1 lanche?",
    options: ["5", "6", "4", "8"],
    correct: 1,
    source: "Adaptada de: OBJETIVA — Prefeitura de Nonoai/RS",
    explanation: "3 sucos × 2 lanches = 6 combinações possíveis (laranja+pão, laranja+biscoito, uva+pão, uva+biscoito, maçã+pão, maçã+biscoito)."
  },
  {
    category: "🕐 Raciocínio Temporal",
    text: "Se hoje é quarta-feira e daqui a 10 dias haverá uma festa, em que dia da semana será a festa?",
    options: ["Sábado", "Sexta-feira", "Domingo", "Segunda-feira"],
    correct: 0,
    source: "Adaptada de: VUNESP — Agente de Correios",
    explanation: "Quarta + 10 dias: 7 dias = outra quarta. Mais 3 dias = sábado."
  }
];

let current = 0;
let score = 0;
let answers = [];

function loadQuestion() {
  const q = questions[current];
  const letters = ['A', 'B', 'C', 'D'];

  document.getElementById('q-category').textContent = q.category;
  document.getElementById('q-number').textContent = `QUESTÃO ${current + 1}`;
  document.getElementById('q-text').textContent = q.text;
  document.getElementById('q-source').textContent = q.source;
  document.getElementById('question-counter').textContent = `Questão ${current + 1} de ${questions.length}`;
  document.getElementById('progress-fill').style.width = `${(current / questions.length) * 100}%`;
  document.getElementById('score-badge').textContent = `✨ ${score} pontos`;

  const optionsArea = document.getElementById('options-area');
  optionsArea.innerHTML = '';

  q.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'option-btn';
    btn.innerHTML = `<span class="option-letter">${letters[i]}</span>${opt}`;
    btn.onclick = () => selectAnswer(i);
    optionsArea.appendChild(btn);
  });

  document.getElementById('feedback').style.display = 'none';
  document.getElementById('next-btn').style.display = 'none';

  // Animate card
  const card = document.getElementById('question-card');
  card.style.animation = 'none';
  card.offsetHeight;
  card.style.animation = 'slideIn 0.4s ease';
}

function selectAnswer(index) {
  const q = questions[current];
  const buttons = document.querySelectorAll('.option-btn');
  buttons.forEach(b => b.disabled = true);

  const isCorrect = index === q.correct;
  buttons[index].classList.add(isCorrect ? 'correct' : 'wrong');

  if (!isCorrect) {
    buttons[q.correct].classList.add('correct');
  }

  if (isCorrect) score += 10;
  answers.push({ correct: isCorrect, text: q.text });

  const fb = document.getElementById('feedback');
  fb.style.display = 'block';
  fb.className = `feedback-box ${isCorrect ? 'correct' : 'wrong'}`;

  const emoji = isCorrect
    ? ['🎉 Arrasei!', '🌟 Mandou bem!', '✅ Correto!', '🔥 Top!'][Math.floor(Math.random() * 4)]
    : ['❌ Quase!', '😬 Ops!', '💡 Atenção!', '🤔 Vamos rever!'][Math.floor(Math.random() * 4)];

  fb.innerHTML = `
    <div class="fb-title">${emoji}</div>
    <div class="fb-explanation">💬 ${q.explanation}</div>
  `;

  document.getElementById('next-btn').style.display = 'block';
  document.getElementById('score-badge').textContent = `✨ ${score} pontos`;
}

function nextQuestion() {
  current++;
  if (current >= questions.length) {
    showResult();
  } else {
    loadQuestion();
  }
}

function showResult() {
  document.getElementById('quiz-area').style.display = 'none';
  const rs = document.getElementById('result-screen');
  rs.style.display = 'block';

  const correct = answers.filter(a => a.correct).length;
  const wrong = answers.length - correct;
  const pct = Math.round((correct / answers.length) * 100);

  document.getElementById('r-correct').textContent = correct;
  document.getElementById('r-wrong').textContent = wrong;
  document.getElementById('r-pct').textContent = pct + '%';

  let trophy = '🏅', title = 'Bom trabalho!', msg = '';
  if (pct === 100) {
    trophy = '🏆'; title = 'Perfeita!';
    msg = 'Uau! Você acertou TUDO! Seu raciocínio lógico está afiado! Continue praticando assim e nenhum desafio vai te parar! 🌟';
  } else if (pct >= 80) {
    trophy = '🥇'; title = 'Ótimo resultado!';
    msg = `Você acertou ${correct} de ${questions.length} questões. Está indo muito bem! Revise os erros e tente superar esse resultado! 💪`;
  } else if (pct >= 60) {
    trophy = '🥈'; title = 'Bom trabalho!';
    msg = `Você acertou ${correct} questões. Está progredindo! Praticar todo dia vai melhorar muito seu raciocínio lógico. 📚`;
  } else {
    trophy = '🌱'; title = 'Continue praticando!';
    msg = `Acertou ${correct} questões. Não desanime! Todo expert já foi iniciante. Leia as explicações e tente de novo! 💡`;
  }

  document.getElementById('result-trophy').textContent = trophy;
  document.getElementById('result-title').textContent = title;
  document.getElementById('congrats-msg').textContent = msg;

  const reviewDiv = document.getElementById('review-items');
  reviewDiv.innerHTML = '';
  answers.forEach((a, i) => {
    const div = document.createElement('div');
    div.className = 'review-item';
    div.innerHTML = `
      <span class="review-dot ${a.correct ? 'ok' : 'fail'}"></span>
      <span>Q${i + 1}: ${questions[i].text.substring(0, 55)}...</span>
    `;
    reviewDiv.appendChild(div);
  });
}

function restartQuiz() {
  current = 0;
  score = 0;
  answers = [];
  document.getElementById('quiz-area').style.display = 'block';
  document.getElementById('result-screen').style.display = 'none';
  loadQuestion();
}

// Start
loadQuestion();
</script>

